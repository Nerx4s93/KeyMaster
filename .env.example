# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env

# Строка подключения SQLite.
# В Docker путь должен указывать на примонтированный volume /data,
# иначе база будет удалена вместе с контейнером.
ConnectionStrings__Default=Data Source=/data/keymaster.db

# Base64-ключ AES-GCM, ровно 32 байта.
# Сгенерировать: openssl rand -base64 32
Encryption__Key=

# SMTP для отправки кодов подтверждения.
# Все поля обязательны: без них приложение не стартует.
Email__Host=smtp.example.com
Email__Port=587
Email__UserName=
Email__Password=
Email__From=noreply@example.com
Email__FromName=KeyMaster

# true  — SSL сразу при подключении (обычно порт 465)
# false — STARTTLS (обычно порт 587)
Email__UseSsl=false
